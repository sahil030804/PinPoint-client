# ─── PinPoint Client Environment Variables ───
# Copy this file to .env.local and fill in your values

# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:4000/v1

# WebSocket URL (for real-time updates)
NEXT_PUBLIC_WS_URL=http://localhost:4000

# Site URL (used for SEO/metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# App name
NEXT_PUBLIC_APP_NAME=PinPoint

# ─── Widget (dogfooding) ───
# Set NEXT_PUBLIC_WIDGET_PROJECT_ID to install the PinPoint widget
# on the PinPoint app itself for dogfooding. Leave empty to disable.
# NEXT_PUBLIC_WIDGET_PROJECT_ID=
# NEXT_PUBLIC_WIDGET_URL=/widget.js
# NEXT_PUBLIC_WIDGET_COLOR=#3B82F6
# NEXT_PUBLIC_WIDGET_POSITION=bottom-right
# NEXT_PUBLIC_WIDGET_BUTTON_TEXT=Feedback
# NEXT_PUBLIC_WIDGET_ICON=chat
